<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Template for Company and Receiver Information -->
    <template id="report_invoice_document_preview_inherited"
              inherit_id="account.report_invoice_document_preview"
              name="Invoice Document Preview (DO Custom)"
              primary="True"> 

                <table id="informations" class="w-100 mb-4" style="width: 100%; border-collapse: collapse; margin-bottom: 24px;">
            <tr>
                <!-- Company Information (Left Column) -->
                <td style="width: 55%; vertical-align: top; padding-right: 15px;">
                    <div style="font-size: 13pt; font-weight: bold; line-height: 1.2;">
                        <strong t-field="o.company_id.partner_id.name"/>
                    </div>
                    <div class="text-muted" style="font-size: 10pt; margin-top: 4px; line-height: 1.3;">
                        <span t-field="o.company_id.partner_id"
                              class="text-muted"
                              t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                    </div>
                    <div style="font-size: 10pt; margin-top: 6px; line-height: 1.4;">
                        <strong>RNC:</strong> <span t-if="o.company_id.vat" t-field="o.company_id.vat"/><br/>
                        <strong>Fecha Emisión:</strong> <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                        <t t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                            <strong>Vencimiento:</strong> <span t-field="o.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                        </t>
                    </div>
                </td>
                <!-- Document Information (Right Column) -->
                <td style="width: 45%; vertical-align: top; text-align: right;">
                    <t t-if="o.l10n_latam_document_type_id">
                        <h2 style="font-size: 18pt; font-weight: bold; margin: 0 0 10px 0; color: #111;" t-field="o.l10n_latam_document_type_id.report_name"/>
                    </t>
                    <div style="font-size: 11pt; line-height: 1.5;">
                        <strong>NCF:</strong> <span style="font-weight: bold;" t-field="o.l10n_do_fiscal_number"/><br/>
                        <t t-if="o.l10n_do_ncf_expiration_date">
                            <strong>Válida hasta:</strong> <span t-field="o.l10n_do_ncf_expiration_date" t-options='{"format": "dd/MM/yyyy"}'/><br/>
                        </t>
                    </div>
                </td>
            </tr>
        </table>
        <!-- Receiver Information -->
        <table id="receiver_info" class="w-100 mb-4" style="width: 100%; border-collapse: collapse; margin-top: 15px; margin-bottom: 24px;">
            <tr>
                <td style="width: 100%; vertical-align: top;">
                    <t t-set="vat_len" t-value="len(o.commercial_partner_id.vat or '')"/>
                    <div style="font-size: 10pt; line-height: 1.4;">
                        <strong>
                            <t t-if="vat_len == 9">RNC:</t>
                            <t t-elif="vat_len == 11">Cédula:</t>
                            <t t-else="">ID Cliente:</t>
                        </strong>
                        <span t-field="o.commercial_partner_id.vat"/><br/>
                        <strong>
                            <t t-if="vat_len == 9">Razón Social:</t>
                            <t t-else="">Nombre:</t>
                        </strong>
                        <span t-field="o.commercial_partner_id.name"/><br/>
                        <span t-if="o.partner_id.street"
                              t-field="o.partner_id"
                              t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}'/>
                    </div>
                </td>
            </tr>
        </table>
    </template>

    <!-- Template for Tax Totals -->
    <template id="invoice_tax_totals" name="Invoice Tax Totals">
        <t t-if="o._name == 'account.move'">
            <t t-set="l10n_do_amounts" t-value="o._get_l10n_do_amounts() or {}"/>
            <table class="table table-sm table-borderless">
                <!-- Subtotal -->
                <tr>
                    <td>Subtotal</td>
                    <td class="text-end">
                        <span t-field="o.amount_untaxed"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <!-- Tax (ITBIS) -->
                <tr>
                    <td>ITBIS</td>
                    <td class="text-end">
                        <span t-field="o.amount_tax_signed"
                              t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                    </td>
                </tr>
                <!-- Total -->
                <tr class="border-top">
                    <td><strong>Total</strong></td>
                    <td class="text-end">
                        <strong>
                            <span t-field="o.amount_total"
                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                        </strong>
                    </td>
                </tr>
            </table>
        </t>
    </template>

    <!-- Main Invoice Report Template -->
    <template id="report_invoice_document_custom" inherit_id="account.report_invoice_document" primary="True">
        <xpath expr="//div[contains(@class, 'invoice_main')]" position="replace">
            <div class="clearfix invoice_main">
                <div class="page">
                    <t t-call="web.external_layout">
                        <t t-set="o" t-value="o.with_context(lang=lang)"/>
                        <t t-set="is_l10n_do_invoice" t-value="o.l10n_latam_use_documents and o.company_id.country_id.code == 'DO'"/>

                        <!-- Header and Receiver Info -->
                        <t t-call="module_name.invoice_informations"/>

                        <!-- Invoice Lines Table -->
                        <table class="table table-striped table-sm" name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th class="text-start">Description</th>
                                    <th class="text-end">Quantity</th>
                                    <th class="text-end">Unit Price</th>
                                    <th class="text-end">Taxes</th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')" t-as="line">
                                    <tr>
                                        <td><span t-field="line.name" t-options='{"widget": "text"}'/></td>
                                        <td class="text-end"><span t-field="line.quantity"/></td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                        <td class="text-end">
                                            <span t-out="', '.join([tax.name for tax in line.tax_ids]) or 'N/A'"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                  t-options='{"widget": "monetary", "display_currency": o.currency_id}'/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals Section -->
                        <div class="row justify-content-end">
                            <div class="col-4">
                                <t t-call="module_name.invoice_tax_totals"/>
                            </div>
                        </div>
                    </t>
                </div>
            </div>
        </xpath>
    </template>



    <!-- Report Definition -->
    <record id="action_report_invoice_custom" model="ir.actions.report">
        <field name="name">Custom Invoice</field>
        <field name="model">account.move</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_do_accounting.report_invoice_document_custom</field>
        <field name="print_report_name">'Invoice - %s' % (object.name)</field>
    </record>
</odoo>