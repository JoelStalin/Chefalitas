<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <template id="informations">
        <table class="table table-borderless w-100 mt-4 mb-4" style="width: 100%; border: none; margin-top: 24px; margin-bottom: 24px;">
            <tr>
                <td style="width: 50%; vertical-align: top; padding: 0;">
                    <strong t-field="o.company_id.partner_id.name" />
                    <br />
                    <span t-field="o.company_id.partner_id"
                        class="text-muted"
                        t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}' />
                    <br />
                    <strong>RNC:</strong>
                    <span t-if="o.company_id.vat" t-field="o.company_id.vat" />
                    <br />
                    <strong>Fecha Emisión:</strong>
                    <span t-field="o.invoice_date" t-options='{"format": "dd/MM/yyyy"}' />
                    <br />
                    <t
                        t-if="o.invoice_date_due and o.move_type == 'out_invoice' and o.state == 'posted'">
                        <strong>Vencimiento:</strong>
                        <span t-field="o.invoice_date_due" t-options='{"format": "dd/MM/yyyy"}' />
                    </t>
                </td>
                <td style="width: 50%; vertical-align: top; padding: 0;">
                    <t t-if="o.l10n_latam_document_type_id">
                        <h2 style="margin-top: 0;">
                            <span t-field="o.l10n_latam_document_type_id.report_name" />
                        </h2>
                    </t>
                    <strong>NCF:</strong>
                    <span t-field="o.l10n_do_fiscal_number" />
                    <br />
                    <!-- <t t-if="o.l10n_do_ncf_expiration_date"> -->
                    <strong>Válida hasta:</strong>
                    <span t-field="o.l10n_do_ncf_expiration_date" t-options='{"format": "dd/MM/yyyy"}' />
                    <!-- </t> -->
                </td>
            </tr>
        </table>
        <div id="receiver_info" class="row mt32 mb32">
            <t t-set="vat_len" t-value="len(o.commercial_partner_id.vat or '')" />
            <div class="col-auto col-7 mw-100 mb-2">
                <strong>
                    <t t-if="vat_len == 9">RNC:</t>
                    <t t-elif="vat_len == 11">Cédula:</t>
                    <t t-else="">ID Cliente:</t>
                </strong>
                <span class="m-0" t-field="o.commercial_partner_id.vat" />
                <br />
                <strong>
                    <t t-if="vat_len == 9">Razón Social:</t>
                    <t t-else="">Nombre:</t>
                </strong>
                <span class="m-0" t-field="o.commercial_partner_id.name" />
                <br />
                <span t-if="o.partner_id.street" class="m-0"
                    t-field="o.partner_id"
                    t-options='{"widget": "contact", "fields": ["address"], "no_marker": true}' />
            </div>
        </div>
    </template>

    <!-- Tax Totals Template -->
    <template id="document_tax_totals">
        <t t-if="o._name == 'account.move'">
            <t t-set="l10n_do_amounts" t-value="o._get_l10n_do_amounts() or {}" />
            <!-- Subtotal -->
            <tr>
                <td>Subtotal</td>
                <td class="text-end">
                    <span t-field="o.amount_untaxed"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                </td>
            </tr>
            <!-- Desglose por grupos de impuestos (ITBIS, Retenciones, etc.) -->
            <t t-if="o.tax_totals and o.tax_totals.get('subtotals')">
                <t t-foreach="o.tax_totals.get('subtotals', [])" t-as="subtotal">
                    <t t-foreach="subtotal.get('tax_groups', [])" t-as="tax_group">
                        <tr>
                            <td><span t-out="tax_group.get('group_name')" /></td>
                            <td class="text-end">
                                <span t-out="tax_group.get('tax_amount_currency')"
                                    t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                            </td>
                        </tr>
                    </t>
                </t>
            </t>
            <t t-else="">
                <tr>
                    <td>ITBIS</td>
                    <td class="text-end">
                        <span t-field="o.itbis_amount"
                            t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                    </td>
                </tr>
            </t>
            <!-- Propina (10%) solo si o.propina_amount != 0 -->
            <t t-if="o.propina_amount">
                <tr>
                    <td>Propina (10%)</td>
                    <td class="text-end">
                        <span t-field="o.propina_amount"
                            t-options='{"widget":"monetary","display_currency":o.currency_id}' />
                    </td>
                </tr>
            </t>
            <!-- Total General -->
            <tr class="border-black o_total">
                <td>
                    <strong>Total</strong>
                </td>
                <td class="text-end">
                    <span t-field="o.amount_total"
                        t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                </td>
            </tr>
        </t>
    </template>

    <!-- Main Report Inheritance -->
    <template id="report_invoice_document_inherited" inherit_id="account.report_invoice_document"
        primary="True">
        <xpath expr="//t[@t-set='layout_document_title']" position="replace">
            <t t-set="layout_document_title">
                <span t-if="o.l10n_do_fiscal_number" t-field="o.l10n_do_fiscal_number" />
                <span t-elif="o.name and o.name != '/'" t-field="o.name" />
            </t>
        </xpath>
        <xpath expr="//div[contains(@class, 'invoice_main')]" position="replace">
            <div class="clearfix invoice_main">
                <div class="page mb-4">
                    <t>
                        <t t-set="o" t-value="o.with_context(lang=lang)" />
                        <t t-set="is_l10n_do_invoice"
                            t-value="o.l10n_latam_use_documents and o.company_id.country_id and o.country_code == 'DO'" />

                        <!-- Header and Receiver Info -->
                        <t t-call="l10n_do_accounting.informations" />

                        <!-- Invoice Line Table -->
                        <table class="o_has_total_table table o_main_table table-borderless"
                            name="invoice_line_table">
                            <thead>
                                <tr>
                                    <th class="text-start">Descripción</th>
                                    <th class="text-end">Cantidad</th>
                                    <th class="text-end">Precio Unitario</th>
                                    <th class="text-end">Impuestos</th>
                                    <th class="text-end">Monto</th>
                                </tr>
                            </thead>
                            <tbody class="invoice_tbody">
                                <t
                                    t-foreach="o.invoice_line_ids.filtered(lambda l: l.display_type == 'product')"
                                    t-as="line">
                                    <tr>
                                        <td>
                                            <span t-field="line.name" t-options='{"widget": "text"}' />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.quantity" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_unit"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                        </td>
                                        <td class="text-end">
                                            <span
                                                t-out="', '.join([tax.name for tax in line.tax_ids])" />
                                        </td>
                                        <td class="text-end">
                                            <span t-field="line.price_subtotal"
                                                t-options='{"widget": "monetary", "display_currency": o.currency_id}' />
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>

                        <!-- Totals -->
                        <div class="row">
                            <div class="col-6 offset-6">
                                <table class="table table-borderless">
                                    <t t-call="l10n_do_accounting.document_tax_totals" />
                                </table>
                            </div>
                        </div>

                        <!-- DGII standard printout: QR, then security code and signature date/time below it -->
                        <div t-if="o.l10n_do_electronic_stamp" class="mt-4" style="page-break-inside: avoid;">
                            <img t-att-src="'/report/barcode/?barcode_type=QR&amp;value=%s&amp;width=160&amp;height=160' % o.l10n_do_electronic_stamp"
                                 style="width: 38mm; height: 38mm;" alt="QR e-CF"/>
                            <div style="font-size: 9pt;">Código de Seguridad: <span t-field="o.l10n_do_ecf_security_code"/></div>
                            <div t-if="o.l10n_do_ecf_sign_stamp or o.l10n_do_ecf_sign_date" style="font-size: 9pt;">
                                Fecha de Firma Digital: <span t-if="o.l10n_do_ecf_sign_stamp" t-out="o.l10n_do_ecf_sign_stamp"/><span t-else="" t-field="o.l10n_do_ecf_sign_date" t-options="{'widget': 'datetime', 'format': 'dd-MM-yyyy HH:mm:ss', 'tz_name': 'America/Santo_Domingo'}"/>
                            </div>
                        </div>


                    </t>
                </div>
            </div>
        </xpath>
    </template>

    <!-- Report Selection Override -->
    <template id="report_invoice" inherit_id="account.report_invoice">
        <xpath expr='//t[@t-call="account.report_invoice_document"]' position="replace">
            <t
                t-if="o._get_name_invoice_report() == 'l10n_do_accounting.report_invoice_document_inherited'"
                t-call="l10n_do_accounting.report_invoice_document_inherited"
                t-lang="lang" />
            <t t-else="" t-call="account.report_invoice_document" t-lang="lang" />
        </xpath>
    </template>

    <!-- Suppress default Odoo logo if company has no custom logo -->
    <template id="external_layout_standard_no_default_logo" inherit_id="web.external_layout_standard">
        <xpath expr="//td[@t-if='company.logo']" position="replace">
            <td t-if="company.logo and not getattr(company, 'uses_default_logo', False)" class="align-top pe-3">
                <img class="o_company_logo_big" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
            </td>
        </xpath>
    </template>

    <!-- Suppress duplicate invisible h3 in wkhtmltopdf -->
    <template id="external_layout_body_clean_title" inherit_id="web.external_layout_body">
        <xpath expr="//h3[contains(@class, 'opacity-0')]" position="replace">
            <h3 t-if="report_type == 'pdf'" t-out="layout_document_title or ' '" style="display: none !important;" class="opacity-0 mb-0 h-0 d-none"/>
        </xpath>
    </template>
</odoo>
