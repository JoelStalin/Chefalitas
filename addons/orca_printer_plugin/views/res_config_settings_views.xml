<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_anyprinter" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.anyprinter</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='point_of_sale']" position="inside">
                <block title="Impresora local (AnyPrinter)" name="anyprinter_block">
                    <div class="o_setting_box col-12 col-lg-8">
                        <div class="o_setting_right_pane">
                            <span class="o_form_label">Plugin para imprimir y abrir la caja</span>
                            <div class="text-muted">
                                Programa para la PC de caja. Imprime en cualquier impresora USB, de Windows o de red y abre la gaveta.
                                Descargue, descomprima y ejecute <b>instalar.bat</b>.
                            </div>
                            <div class="mt-2">
                                <a class="btn btn-primary" role="button" href="/orca_printer/download" target="_blank">Descargar AnyPrinter.zip</a>
                            </div>
                        </div>
                    </div>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
