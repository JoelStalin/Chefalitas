<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_fripick_order_list" model="ir.ui.view">
        <field name="name">fripick.order.list</field>
        <field name="model">fripick.order</field>
        <field name="arch" type="xml">
            <list create="false">
                <field name="closed_at"/>
                <field name="name"/>
                <field name="company_id"/>
                <field name="amount_total"/>
                <field name="invoice_id"/>
            </list>
        </field>
    </record>
    <record id="view_fripick_order_form" model="ir.ui.view">
        <field name="name">fripick.order.form</field>
        <field name="model">fripick.order</field>
        <field name="arch" type="xml">
            <form create="false">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="closed_at"/>
                        <field name="amount_total"/>
                        <field name="invoice_id"/>
                    </group>
                    <field name="line_ids">
                        <list>
                            <field name="qty"/>
                            <field name="name"/>
                            <field name="preparation"/>
                        </list>
                    </field>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_fripick_print_job_list" model="ir.ui.view">
        <field name="name">fripick.print.job.list</field>
        <field name="model">fripick.print.job</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'" decoration-muted="state == 'done'">
                <field name="create_date"/>
                <field name="printer_id"/>
                <field name="kind"/>
                <field name="origin"/>
                <field name="state"/>
                <field name="attempts"/>
                <field name="error"/>
            </list>
        </field>
    </record>
    <record id="action_fripick_orders" model="ir.actions.act_window">
        <field name="name">Pedidos Fripick</field>
        <field name="res_model">fripick.order</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- printers are the POS printers (pos_printing_suite): network discovery, local agent or cloud gateway -->
    <record id="action_fripick_printers" model="ir.actions.act_window">
        <field name="name">Impresoras</field>
        <field name="res_model">pos.printer</field>
        <field name="view_mode">list,form</field>
    </record>
    <record id="action_fripick_print_jobs" model="ir.actions.act_window">
        <field name="name">Cola de impresión</field>
        <field name="res_model">fripick.print.job</field>
        <field name="view_mode">list</field>
    </record>
    <menuitem id="menu_fripick_root" name="Fripick" parent="point_of_sale.menu_point_root" sequence="90"/>
    <menuitem id="menu_fripick_orders" name="Pedidos" parent="menu_fripick_root" action="action_fripick_orders" sequence="10"/>
    <menuitem id="menu_fripick_printers" name="Impresoras" parent="menu_fripick_root" action="action_fripick_printers" sequence="20"/>
    <menuitem id="menu_fripick_jobs" name="Cola de impresión" parent="menu_fripick_root" action="action_fripick_print_jobs" sequence="30"/>
</odoo>
