<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="pos_order_receipt_order_barcode" inherit_id="point_of_sale.pos_order_receipt">
        <xpath expr="//div[@name='before-footer']" position="before">
            <div class="w-100 text-center mt-2 mb-2" name="order_barcode"
                 t-if="image.get('order_barcode') and order['state'] != 'draft'">
                <img t-att-src="image['order_barcode']" style="width: 95%; height: auto;"/>
                <div class="text-small">Escanee este código para una devolución</div>
            </div>
        </xpath>
    </template>
</odoo>
