<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form_orca_bridge" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.orca_bridge</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='invoicing_settings']" position="after">
                <block id="orca_bridge_block" title="ORCA" groups="base.group_system">
                    <setting id="orca_bridge_connector_setting" string="Conector ORCA (OAuth 2.0)"
                             help="Registre la compania y el conector en ORCA > Configuracion; luego conecte con un administrador de ORCA.">
                        <div class="content-group">
                            <div class="mt8"><field name="orca_bridge_status" readonly="1"
                                 decoration-success="orca_bridge_connected" decoration-muted="not orca_bridge_connected"/></div>
                            <div class="row mt8"><label for="orca_bridge_url" class="col-lg-3 o_light_label"/>
                                <field name="orca_bridge_url" placeholder="https://orca.example.com"/></div>
                            <div class="row mt8"><label for="orca_bridge_client_id" class="col-lg-3 o_light_label"/>
                                <field name="orca_bridge_client_id"/></div>
                            <div class="row mt8"><label for="orca_bridge_client_secret" class="col-lg-3 o_light_label"/>
                                <field name="orca_bridge_client_secret" password="True"/></div>
                            <div class="row mt8"><label for="orca_bridge_redirect_uri" class="col-lg-3 o_light_label"/>
                                <field name="orca_bridge_redirect_uri" readonly="1"/></div>
                            <div class="mt8">
                                <button name="action_orca_bridge_connect" type="object" class="btn-primary"
                                        string="Conectar con ORCA" invisible="orca_bridge_connected"/>
                                <button name="action_orca_bridge_connect" type="object" class="btn-link"
                                        string="Reconectar" icon="oi-arrow-right" invisible="not orca_bridge_connected"/>
                                <button name="action_orca_bridge_test_connection" type="object" class="btn-link"
                                        string="Probar conexion" icon="oi-arrow-right" invisible="not orca_bridge_connected"/>
                                <button name="action_orca_bridge_disconnect" type="object" class="btn-link text-danger"
                                        string="Desconectar" invisible="not orca_bridge_connected"
                                        confirm="ORCA perdera el acceso a esta base de datos y se revocara la clave del usuario ORCA. ¿Continuar?"/>
                            </div>
                        </div>
                    </setting>
                    <setting id="orca_bridge_events_setting" string="Notificar cambios a ORCA"
                             help="Facturas, pedidos POS, contactos y transferencias: ids y campos cambiados, sin valores.">
                        <field name="orca_bridge_push_events"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
