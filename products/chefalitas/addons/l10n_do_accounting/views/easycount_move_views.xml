<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- e-CF result returned by EasyCount / DGII, visible on the invoice (live browser test: it was nowhere). -->
    <record id="view_move_form_easycount_ecf" model="ir.ui.view">
        <field name="name">account.move.form.easycount.ecf</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_l10n_do_easycount_retry" type="object" string="Reenviar e-CF a DGII"
                        class="btn-primary" invisible="not l10n_do_easycount_pending or state != 'posted'"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="e-CF DGII" name="l10n_do_easycount_ecf"
                      invisible="country_code != 'DO' or (not l10n_do_easycount_track_id and not l10n_do_easycount_pending)">
                    <group>
                        <group string="Respuesta DGII">
                            <field name="l10n_do_easycount_status" readonly="1"
                                   decoration-success="l10n_do_easycount_status == 'Aceptado'"
                                   decoration-warning="l10n_do_easycount_status in ('Aceptado Condicional', 'En Proceso')"/>
                            <field name="l10n_do_easycount_track_id" readonly="1"/>
                            <field name="l10n_do_ecf_security_code" readonly="1"/>
                            <field name="l10n_do_ecf_sign_date" readonly="1"/>
                            <field name="l10n_do_easycount_emulated" readonly="1"/>
                            <field name="l10n_do_easycount_pending" readonly="1" invisible="not l10n_do_easycount_pending"/>
                        </group>
                        <group string="Documento electronico">
                            <field name="l10n_do_fiscal_number" readonly="1" string="e-NCF"/>
                            <field name="l10n_do_ecf_edi_file" filename="l10n_do_ecf_edi_file_name" readonly="1"/>
                            <field name="l10n_do_ecf_edi_file_name" invisible="1"/>
                            <field name="l10n_do_electronic_stamp" readonly="1" string="Sello / QR"/>
                        </group>
                    </group>
                    <field name="l10n_do_easycount_messages" readonly="1" invisible="not l10n_do_easycount_messages"
                           placeholder="Sin mensajes de DGII"/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
