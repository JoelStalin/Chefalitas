<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="l10n_do_easycount_credentials_wizard_form" model="ir.ui.view">
        <field name="name">l10n_do.easycount.credentials.wizard.form</field>
        <field name="model">l10n_do.easycount.credentials.wizard</field>
        <field name="arch" type="xml">
            <form string="Credenciales DGII en EasyCount">
                <div class="alert alert-info" role="status">
                    Se envían a EasyCount, que las valida y las guarda cifradas. Odoo no conserva el certificado ni las claves.
                </div>
                <group>
                    <field name="company_id"/>
                    <field name="company_vat"/>
                    <field name="status_text" nolabel="1" colspan="2"/>
                </group>
                <group string="Certificado de firma">
                    <field name="p12_file" filename="p12_filename"/>
                    <field name="p12_filename" invisible="1"/>
                    <field name="p12_password" password="True"/>
                    <div colspan="2" class="text-muted">
                        Puede ser el certificado de la empresa o el personal de la persona autorizada a firmar por ella; EasyCount lo reconoce solo.
                    </div>
                </group>
                <group string="Portal de certificación e-CF de la DGII">
                    <field name="portal_user"/>
                    <field name="portal_password" password="True"/>
                </group>
                <footer>
                    <button name="action_send" type="object" string="Enviar a EasyCount" class="btn-primary"/>
                    <button string="Cancelar" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_l10n_do_easycount_credentials_wizard" model="ir.actions.act_window">
        <field name="name">Credenciales DGII en EasyCount</field>
        <field name="res_model">l10n_do.easycount.credentials.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
