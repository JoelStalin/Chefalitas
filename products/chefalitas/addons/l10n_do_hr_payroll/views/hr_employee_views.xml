<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_form_l10n_do" model="ir.ui.view">
        <field name="name">hr.employee.form.l10n.do</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='personal_information']" position="inside">
                <group string="Datos Fiscales y Seguridad Social (Rep. Dominicana)" name="l10n_do_fiscal">
                    <group>
                        <field name="l10n_do_identification_type"/>
                        <field name="l10n_do_identification_id"/>
                        <field name="l10n_do_nss"/>
                    </group>
                    <group>
                        <field name="l10n_do_salary_payment_frequency"/>
                        <field name="l10n_do_is_exempt_isr"/>
                        <field name="l10n_do_has_other_income"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>