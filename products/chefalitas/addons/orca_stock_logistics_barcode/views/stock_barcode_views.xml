<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- 1. Extend Product Packaging View with qty_per_box & Hierarchy -->
    <record id="view_product_packaging_form_orca_barcode" model="ir.ui.view">
        <field name="name">product.packaging.form.orca.barcode</field>
        <field name="model">product.packaging</field>
        <field name="inherit_id" ref="product.product_packaging_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='barcode']" position="after">
                <field name="package_level_type"/>
                <field name="qty_per_box"/>
                <field name="parent_packaging_id"/>
                <field name="effective_unit_factor" readonly="1"/>
            </xpath>
        </field>
    </record>

    <!-- 2. Extend Stock Picking Form with High-Speed Laser Scanner Button & Scan Logs -->
    <record id="view_picking_form_orca_barcode" model="ir.ui.view">
        <field name="name">stock.picking.form.orca.barcode</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_open_orca_barcode_scanner"
                        string="Modo Pistola Láser (OWL)"
                        type="object"
                        class="btn-primary"
                        icon="fa-barcode"
                        invisible="state in ('done', 'cancel')"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Barcode Laser Scans" name="orca_barcode_scans">
                    <group>
                        <group>
                            <field name="orca_last_scanned_barcode" readonly="1"/>
                            <field name="orca_total_barcode_scans" readonly="1"/>
                        </group>
                    </group>
                    <field name="orca_scan_log_ids" readonly="1">
                        <list string="Scan History">
                            <field name="create_date"/>
                            <field name="barcode"/>
                            <field name="match_type"/>
                            <field name="product_id"/>
                            <field name="packaging_id"/>
                            <field name="scan_count"/>
                            <field name="qty_per_box"/>
                            <field name="total_units_added"/>
                            <field name="user_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <!-- 3. Stock Inventory Session Views (OCA v20 Compatible) -->
    <record id="view_orca_stock_inventory_list" model="ir.ui.view">
        <field name="name">stock.inventory.list.orca.barcode</field>
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <list string="Barcode Inventory Sessions">
                <field name="name"/>
                <field name="date"/>
                <field name="location_id"/>
                <field name="orca_total_barcode_scans"/>
                <field name="orca_last_scanned_barcode"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-warning="state == 'confirm'"
                       decoration-success="state == 'done'"/>
            </list>
        </field>
    </record>

    <record id="view_orca_stock_inventory_form" model="ir.ui.view">
        <field name="name">stock.inventory.form.orca.barcode</field>
        <field name="model">stock.inventory</field>
        <field name="arch" type="xml">
            <form string="Barcode Inventory Session">
                <header>
                    <button name="action_start_inventory"
                            string="Start Inventory"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button name="action_open_orca_barcode_scanner"
                            string="Open Laser Scanner (OWL)"
                            type="object"
                            class="btn-primary"
                            icon="fa-barcode"
                            invisible="state in ('done', 'cancel')"/>
                    <button name="action_validate_inventory"
                            string="Validate &amp; Apply to Quants"
                            type="object"
                            class="btn-success"
                            invisible="state != 'confirm'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="state == 'done'"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="location_id" readonly="state == 'done'"/>
                            <field name="company_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="date" readonly="state == 'done'"/>
                            <field name="orca_total_barcode_scans" readonly="1"/>
                            <field name="orca_last_scanned_barcode" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Counted Lines" name="lines">
                            <field name="line_ids" readonly="state == 'done'">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="location_id"/>
                                    <field name="last_packaging_id"/>
                                    <field name="last_qty_per_box"/>
                                    <field name="theoretical_qty"/>
                                    <field name="product_qty"/>
                                    <field name="difference_qty"/>
                                    <field name="product_uom_id"/>
                                </list>
                            </field>
                        </page>
                        <page string="Laser Scan Audit Log" name="scan_logs">
                            <field name="scan_log_ids" readonly="1">
                                <list>
                                    <field name="create_date"/>
                                    <field name="barcode"/>
                                    <field name="match_type"/>
                                    <field name="product_id"/>
                                    <field name="packaging_id"/>
                                    <field name="scan_count"/>
                                    <field name="qty_per_box"/>
                                    <field name="total_units_added"/>
                                    <field name="user_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. External Barcode Enrichment Cache View -->
    <record id="view_orca_barcode_enrichment_cache_list" model="ir.ui.view">
        <field name="name">orca.barcode.enrichment.cache.list</field>
        <field name="model">orca.barcode.enrichment.cache</field>
        <field name="arch" type="xml">
            <list string="External API Barcode Enrichment Cache">
                <field name="barcode"/>
                <field name="barcode_standard"/>
                <field name="is_master_pack_barcode"/>
                <field name="inferred_qty_per_box"/>
                <field name="product_name"/>
                <field name="brand"/>
                <field name="weight"/>
                <field name="quantity_label"/>
                <field name="source_api"/>
                <field name="product_id"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <!-- 5. Actions & Menus -->
    <record id="action_orca_barcode_scanner_standalone" model="ir.actions.client">
        <field name="name">ORCA Laser Barcode Terminal</field>
        <field name="tag">orca_stock_logistics_barcode.ScannerClientAction</field>
    </record>

    <record id="action_orca_stock_inventory_sessions" model="ir.actions.act_window">
        <field name="name">Barcode Inventory Sessions</field>
        <field name="res_model">stock.inventory</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_orca_barcode_enrichment_cache" model="ir.actions.act_window">
        <field name="name">External Barcode Enrichment Cache</field>
        <field name="res_model">orca.barcode.enrichment.cache</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_orca_stock_barcode_root"
              name="ORCA Barcode v20"
              parent="stock.menu_stock_root"
              sequence="4"/>

    <menuitem id="menu_orca_stock_barcode_terminal"
              name="High-Speed Laser Terminal"
              parent="menu_orca_stock_barcode_root"
              action="action_orca_barcode_scanner_standalone"
              sequence="10"/>

    <menuitem id="menu_orca_stock_inventory_sessions"
              name="Barcode Inventory Counts"
              parent="menu_orca_stock_barcode_root"
              action="action_orca_stock_inventory_sessions"
              sequence="20"/>

    <menuitem id="menu_orca_barcode_enrichment_cache"
              name="External API Enrichment Cache"
              parent="menu_orca_stock_barcode_root"
              action="action_orca_barcode_enrichment_cache"
              sequence="30"/>
</odoo>
