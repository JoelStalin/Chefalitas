<odoo>
    <record id="report_recipe_cost" model="ir.actions.report">
        <field name="name">Recipe Cost Sheet</field>
        <field name="model">rest.recipe</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">pos_kitchen_core.recipe_cost_report</field>
        <field name="binding_model_id" ref="model_rest_recipe"/>
        <field name="binding_type">report</field>
    </record>

    <template id="recipe_cost_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-set="o" t-value="doc"/>
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-out="doc.name"/>
                        <p><strong>Product:</strong> <t t-out="doc.product_id.display_name"/></p>
                        <p><strong>Expected portions:</strong> <t t-out="doc.expected_portions"/></p>
                        <p><strong>Theoretical total cost:</strong> <t t-out="doc.theoretical_total_cost"/></p>
                        <table class="table table-sm">
                            <thead>
                                <tr>
                                    <th>Ingredient</th>
                                    <th>Qty (g)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.line_ids" t-as="line">
                                    <tr>
                                        <td><t t-out="line.ingredient_id.display_name"/></td>
                                        <td><t t-out="line.qty_g"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>
</odoo>
